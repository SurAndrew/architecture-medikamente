        <mxCell id="8b8HBLIM3U6xf5DyuTWQ-13" value="" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;align=left;verticalAlign=top;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=22;fontColor=#393C56;fillColor=none;labelBackgroundColor=none;strokeColor=#E07A5F;rounded=1;" parent="1" vertex="1">
